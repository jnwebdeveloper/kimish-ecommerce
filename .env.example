# Server-only settings. Never prefix credentials with VITE_.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
AUTH_ORIGIN=http://localhost:5173

# PostgreSQL / initial administrator (replace placeholders before setup)
POSTGRES_DB=kimish
POSTGRES_USER=kimish
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://kimish:replace-with-a-long-random-password@127.0.0.1:5434/kimish
ADMIN_EMAIL=admin@kimish.local
ADMIN_PASSWORD=replace-with-a-long-random-password
PORT=3000

# Razorpay (server secret must never use VITE_ prefix)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket API user credentials
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
# 6-digit PIN code of the pickup location, used for checkout rate estimates
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_WEBHOOK_SECRET=

# Required to authorize sensitive administrator management and audit views
PRIMARY_ADMIN_EMAIL=

# Neon (production): use the pooled connection string for DATABASE_URL on Vercel, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional override for connections per serverless instance (default 3 on Vercel, 10 locally)
PG_POOL_MAX=
