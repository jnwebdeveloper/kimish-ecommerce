# Server-only settings. Never prefix credentials with VITE_.

# ---- Phone OTP login (Twilio Verify) ----
# All three must be set to enable "Login with your phone"; leave blank to disable it (guest checkout still works).
# Also add them in Vercel -> Project -> Settings -> Environment Variables for production.
# Account SID (starts with AC): Twilio Console home page -> Account Info.
TWILIO_ACCOUNT_SID=
# Auth Token: Twilio Console home page -> Account Info (click "Show"). Keep secret.
TWILIO_AUTH_TOKEN=
# Verify Service SID (starts with VA): Console -> Verify -> Services -> Create new (enable the SMS channel).
TWILIO_VERIFY_SERVICE_SID=
# Exact origin the site is opened from, no trailing slash. Login requests from any other origin are rejected.
# Local: http://localhost:5173   Production (Vercel): your live URL, e.g. https://yourdomain.com
AUTH_ORIGIN=http://localhost:5173

# PostgreSQL / initial administrator (replace placeholders before setup)
POSTGRES_DB=kimish
POSTGRES_USER=kimish
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://kimish:replace-with-a-long-random-password@127.0.0.1:5434/kimish
ADMIN_EMAIL=admin@kimish.local
ADMIN_PASSWORD=replace-with-a-long-random-password
PORT=3000

# Razorpay (server secret must never use VITE_ prefix)
# Test Mode keys: Razorpay Dashboard -> switch to Test Mode -> Account & Settings -> API Keys.
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
# Any long random string; must match the secret entered for the webhook
# https://YOUR-DOMAIN/api/webhooks/razorpay (Dashboard -> Webhooks; enable payment.captured and payment.failed).
RAZORPAY_WEBHOOK_SECRET=any-long-random-string

# Shiprocket API user credentials
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Fallback only: choose the pickup address in Admin > Site Settings instead
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_SECRET=

# Required to authorize sensitive administrator management and audit views
PRIMARY_ADMIN_EMAIL=

# Neon (production): use the pooled connection string for DATABASE_URL on Vercel, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional override for connections per serverless instance (default 3 on Vercel, 10 locally)
PG_POOL_MAX=

# Server log detail: debug | info (default) | warn | error | silent. Logs are JSON lines on stdout/stderr.
LOG_LEVEL=
