# Server-only settings. Never prefix credentials with VITE_.

# ---- Phone OTP login (Twilio Verify) ----
# All three must be set to enable "Login with your phone"; leave blank to disable it (guest checkout still works).
# Also add them in Vercel -> Project -> Settings -> Environment Variables for production.
# Account SID (starts with AC): Twilio Console home page -> Account Info.
TWILIO_ACCOUNT_SID=
# Auth Token: Twilio Console home page -> Account Info (click "Show"). Keep secret.
TWILIO_AUTH_TOKEN=
# Verify Service SID (starts with VA): Console -> Verify -> Services -> Create new (enable the SMS channel).
TWILIO_VERIFY_SERVICE_SID=
# Exact origin the site is opened from, no trailing slash. Login requests from any other origin are rejected.
# Local: http://localhost:5173   Production (Vercel): your live URL, e.g. https://yourdomain.com
AUTH_ORIGIN=http://localhost:5173

# PostgreSQL / initial administrator (replace placeholders before setup)
POSTGRES_DB=kimish
POSTGRES_USER=kimish
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://kimish:replace-with-a-long-random-password@127.0.0.1:5434/kimish
ADMIN_EMAIL=admin@kimish.local
ADMIN_PASSWORD=replace-with-a-long-random-password
PORT=3000

# Razorpay (server secret must never use VITE_ prefix)
# Test Mode keys: Razorpay Dashboard -> switch to Test Mode -> Account & Settings -> API Keys.
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
# Any long random string; must match the secret entered for the webhook
# https://YOUR-DOMAIN/api/webhooks/razorpay (Dashboard -> Webhooks; enable payment.captured and payment.failed).
RAZORPAY_WEBHOOK_SECRET=any-long-random-string

# Shiprocket API user credentials
# Leave empty for live (https://apiv2.shiprocket.in); set to the sandbox URL Shiprocket gives you to test
SHIPROCKET_BASE_URL=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Fallback only: choose the pickup address in Admin > Site Settings instead
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_SECRET=

# Required to authorize sensitive administrator management and audit views
PRIMARY_ADMIN_EMAIL=

# Neon (production): use the pooled connection string for DATABASE_URL on Vercel, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional override for connections per serverless instance (default 3 on Vercel, 10 locally)
PG_POOL_MAX=

# Server log detail: debug | info (default) | warn | error | silent. Logs are JSON lines on stdout/stderr.
LOG_LEVEL=

# ---------------------------------------------------------------------------
# Media storage (admin photo and video uploads). Server-only: never expose these
# values; the browser only ever gets short-lived signed upload links.
# Full setup guide: docs/media-storage-setup.md
#
# Files go straight from the admin's browser to the bucket, so they never pass
# through the API (Vercel caps request bodies at 4.5 MB). Limits: images
# (JPG, PNG, WebP) up to 8 MB, videos (MP4, WebM) up to 50 MB.
#
# Each storage is a numbered block of STORAGE_<n>_* variables. Types:
#   r2      Cloudflare R2 (recommended)
#   s3      Amazon S3
#   custom  any other S3-compatible service (MinIO, Backblaze B2, ...)
# Vercel Blob can't take direct uploads. A leftover vercel-blob block doesn't
# stop the API, but uploads stay off while it is the active storage.
#
# STORAGE_ACTIVE is the number of the storage that receives NEW uploads
# (unset = lowest number). Files uploaded earlier keep their full URL in the
# database and still load from where they were uploaded, so keep old buckets public.
#
# Every storage block:
#   STORAGE_<n>_TYPE        r2 | s3 | custom                       (required)
#   STORAGE_<n>_NAME        label shown in logs (optional)
#   STORAGE_<n>_BUCKET      bucket name
#   STORAGE_<n>_KEY_ID      access key ID (R2: "Access Key ID" of the API token)
#   STORAGE_<n>_SECRET      secret access key
#   STORAGE_<n>_PUBLIC_URL  HTTPS base URL files are served from, no trailing
#                           slash, e.g. https://media.yourdomain.com or
#                           https://pub-xxxx.r2.dev. Your own domain lets you move
#                           buckets later without rewriting saved URLs.
#   plus, depending on TYPE:
#     r2      STORAGE_<n>_ACCOUNT_ID  Cloudflare account ID (endpoint is built for you)
#     s3      STORAGE_<n>_REGION      AWS region, e.g. ap-south-1
#     custom  STORAGE_<n>_ENDPOINT    S3 API URL
#             STORAGE_<n>_REGION      region the service expects (MinIO: us-east-1)
#
# Every declared block is checked at startup; a missing value stops the API with
# an error naming the variable. Never renumber or reuse a number. Give each key
# Object Read & Write access to its own bucket only. Each bucket needs a CORS
# rule allowing PUT from your site (see the guide).
# The older R2_* variables (R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
# R2_BUCKET_NAME, R2_PUBLIC_URL) still work as storage 1 when no STORAGE_<n>_*
# variables are set. Leave everything blank to disable uploads.
# ---------------------------------------------------------------------------
# Commented out so a copied .env still starts. Uncomment and fill in every value.
# STORAGE_ACTIVE=1

# Storage 1: Cloudflare R2
# STORAGE_1_TYPE=r2
# STORAGE_1_NAME=Cloudflare R2
# STORAGE_1_ACCOUNT_ID=
# STORAGE_1_BUCKET=
# STORAGE_1_KEY_ID=
# STORAGE_1_SECRET=
# STORAGE_1_PUBLIC_URL=

# Storage 2: Amazon S3 (set STORAGE_ACTIVE=2 to send new uploads here)
# STORAGE_2_TYPE=s3
# STORAGE_2_NAME=Amazon S3
# STORAGE_2_REGION=ap-south-1
# STORAGE_2_BUCKET=
# STORAGE_2_KEY_ID=
# STORAGE_2_SECRET=
# STORAGE_2_PUBLIC_URL=
